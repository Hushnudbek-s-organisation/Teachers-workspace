# ---------------------------------------------------------------
# Supabase sozlamalari (Project Settings -> API)
# Bu faylni `.env.local` deb nusxalang va qiymatlarni to'ldiring.
#
# MUHIM: Agar bu o'zgaruvchilar bo'sh bo'lsa, ilova AVTOMATIK
# ravishda "Demo rejimi"ga o'tadi (xotiradagi namoyish
# ma'lumotlari bilan) — Supabase'ni ulamasdan ham UI sinab ko'riladi.
# ---------------------------------------------------------------

# Supabase project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Faqat server uchun: service role key (RLS'ni chetlab o'tadi).
# Kelajakda auth qo'shilsa, bu kalitni olib tashlab, RLS + @supabase/ssr dan foydalaning.
SUPABASE_SERVICE_ROLE_KEY=
