# ---------------------------------------------------------------
# Supabase sozlamalari (Project Settings -> API)
# Bu faylni `.env.local` deb nusxalang va qiymatlarni to'ldiring.
#
# MUHIM: Agar bu o'zgaruvchilar bo'sh bo'lsa, ilova AVTOMATIK
# "Demo rejimi"ga o'tadi (xotiradagi namoyish ma'lumotlari bilan,
# demo hisob: ustoz@demo.uz / demo1234) — Supabase'ni ulamasdan ham
# UI sinab ko'riladi. Prod da albatta Supabase ulanadi.
# ---------------------------------------------------------------

# Ilovaning ommaviy manzili (portal havolalari shu manzildan yasaladi).
# Lokal: http://localhost:3000 · Vercel: https://sizning-loyingiz.vercel.app
# Portal o'quvchi havolalari: <NEXT_PUBLIC_SITE_URL>/o/<token>
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Faqat server uchun: service role key (RLS'ni chetlab o'tadi).
# Ilovada o'qituvchi autentifikatsiyasi SERVER tomonda (cookie sessiya +
# scrypt parollar, src/lib/auth-core.ts) — sahifalar va server action'lar
# requireTeacher/requireTeacherAction bilan himoyalangan, shuning uchun
# barcha DB yozishlari serverdan service key bilan ketadi va kalit
# brauzerga chiqmaydi.
SUPABASE_SERVICE_ROLE_KEY=
